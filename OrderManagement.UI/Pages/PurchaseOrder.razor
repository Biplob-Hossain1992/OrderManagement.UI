@page "/purchaseorder"
@using OrderManagement.UI.Data;
@inject HttpClient Http

<PageTitle>Purchase Order</PageTitle>

<div class="container mt-3">
    <div class="card">
        <div class="card-header text-center">Purchase Order Entry Form</div>
        <div class="card-body">
            <form>
                <div class="row">
                    <div class="col-6">
                        <div class="row">
                            <div class="col-2">
                                <label for="refId" class="form-label">Ref. ID:</label>
                            </div>
                            <div class="col-10">
                                <input type="text" class="form-control refId" id="refId" name="refId" @bind="@order.ReferenceId">
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-2">
                                <label for="poDate" class="form-label">PO Date:</label>
                            </div>
                            <div class="col-10">
                                <input type="date" class="form-control poDate" id="poDate" name="poDate" @bind="@order.OrderDate">
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-2">
                                <label for="expDate" class="form-label">Expected Date:</label>
                            </div>
                            <div class="col-10">
                                <input type="date" class="form-control expDate" id="expDate" name="expDate" @bind="@order.ExpectedDate">
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="row">
                            <div class="col-2">
                                <label for="poNo" class="form-label">PO No:</label>
                            </div>
                            <div class="col-10">
                                <input type="text" class="form-control poNo" id="poNo" name="poNo" @bind="@order.OrderNo">
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-2">
                                <label for="supplier" class="form-label">Supplier:</label>
                            </div>
                            <div class="col-10">
                                <select class="form-control supplier" id="supplier" name="supplier" @bind="@order.SupplierId">
                                    <option>1</option>
                                    <option>1</option>
                                    <option>1</option>
                                </select>
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-2">
                                <label for="remarks" class="form-label">Remarks:</label>
                            </div>
                            <div class="col-10">
                                <textarea class="form-control remarks" rows="3" name="remarks" id="remarks" @bind="@order.Remarks"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
        <div class="card-footer">
            <div class="row">
                <div class="col-5">
                    <div class="row">
                        <div class="col-2">
                            <label for="item" class="form-label">Item:</label>
                        </div>
                        <div class="col-10">
                            <input type="text" class="form-control item" id="item" name="item">
                        </div>
                    </div>
                </div>
                <div class="col-3">
                    <div class="row">
                        <div class="col-2">
                            <label for="qty" class="form-label">Qty:</label>
                        </div>
                        <div class="col-10">
                            <input type="text" class="form-control qty" id="qty" name="qty">
                        </div>
                    </div>
                </div>
                <div class="col-3">
                    <div class="row">
                        <div class="col-2">
                            <label for="rate" class="form-label">Rate:</label>
                        </div>
                        <div class="col-10">
                            <input type="text" class="form-control rate" id="rate" name="rate">
                        </div>
                    </div>
                </div>
                <div class="col-1">
                    <div class="row">
                        <button type="button" class="btn btn-secondary" style="width:89%"><span class="oi oi-plus"></span></button>
                    </div>
                </div>
            </div>
            <table class="table table-hover table-striped table-bordered mt-1" style="background-color: ghostwhite;">
                <thead>
                    <tr class="text-center">
                        <th style="text-align:left;">Item Name</th>
                        <th>Qty.</th>
                        <th>Rate($)</th>
                        <th>Edit</th>
                        <th>Delete</th>
                    </tr>
                </thead>
                <tbody>
                    <tr class="text-center">
                        <td style="text-align:left;">A</td>
                        <td>5</td>
                        <td>10</td>
                        <td style="cursor:pointer;"><span class="oi oi-pencil" aria-hidden="true"></span></td>
                        <td style="cursor:pointer;"><span class="oi oi-trash" aria-hidden="true"></span></td>
                    </tr>
                    <tr class="text-center">
                        <td style="text-align:left;">A</td>
                        <td>5</td>
                        <td>10</td>
                        <td style="cursor:pointer;"><span class="oi oi-pencil" aria-hidden="true"></span></td>
                        <td style="cursor:pointer;"><span class="oi oi-trash" aria-hidden="true"></span></td>
                    </tr>
                    <tr class="text-center">
                        <td style="text-align:left;">A</td>
                        <td>5</td>
                        <td>10</td>
                        <td style="cursor:pointer;"><span class="oi oi-pencil" aria-hidden="true"></span></td>
                        <td style="cursor:pointer;"><span class="oi oi-trash" aria-hidden="true"></span></td>
                    </tr>
                </tbody>
            </table>
            <div class="row float-end">
                <div class="col-6">
                    <button type="button" class="btn btn-primary" @onclick="@CreateOrder">Save</button>
                </div>
                <div class="col-6">
                    <button type="button" class="btn btn-danger">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    VmOrder order = new VmOrder();

    protected async Task CreateOrder()
    {
        var data = await Http.PostAsJsonAsync("https://localhost:44337/api/order/CreateOrder", order);
    }
}
