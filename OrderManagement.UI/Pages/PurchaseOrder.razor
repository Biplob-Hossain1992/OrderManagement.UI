@page "/"

@page "/purchaseorder"
@using OrderManagement.UI.Models;
@using System.Text.Json;
@using System.Text;
@using Blazored.Typeahead;
@inject HttpClient Http

<PageTitle>Purchase Order</PageTitle>

<div class="container mt-3">
    <div class="card">
        <div class="card-header text-center">Purchase Order Entry Form</div>
        <EditForm Model="@order" OnValidSubmit="@CreateOrder">
            <DataAnnotationsValidator />
        <div class="card-body">
            <div class="row">
                <div class="col-6">
                    <div class="row">
                        <div class="col-2">
                            <label for="refId" class="form-label">Ref. ID:</label>
                        </div>
                        <div class="col-10">
                            @*<input type="text" class="form-control" @onclick="@incrementDecrement" @bind-value="@order.ReferenceId">*@
                            <div class="input-group">
                                <span class="input-group-btn">
                                    <button type="button" @onclick="@Decrement" class="btn btn-danger btn-number">
                                        <span class="oi oi-caret-left"></span>
                                    </button>
                                </span>
                                <input type="text" id="quantity" name="quantity" class="form-control input-number text-center" @bind-value="@order.ReferenceId" min="001" max="100">
                                <span class="input-group-btn">
                                    <button type="button" @onclick="@Increment" class="btn btn-success btn-number">
                                        <span class="oi oi-caret-right"></span>
                                    </button>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="row mt-2">
                        <div class="col-2">
                            <label for="poDate" class="form-label">PO Date:</label>
                        </div>
                        <div class="col-10">
                            <input type="date" class="form-control" @bind-value="@order.OrderDate">
                        </div>
                    </div>
                    <div class="row mt-2">
                        <div class="col-2">
                            <label for="expDate" class="form-label">Expected Date:</label>
                        </div>
                        <div class="col-10">
                            <input type="date" class="form-control"  @bind="@order.ExpectedDate">
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="row">
                        <div class="col-2">
                            <label for="poNo" class="form-label">PO No:</label>
                        </div>
                        <div class="col-10">
                            <input type="text" class="form-control poNo" id="poNo" name="poNo" @bind="@order.OrderNo">
                            <ValidationMessage For="@(() => order.OrderNo)"></ValidationMessage>
                        </div>
                    </div>
                    <div class="row mt-2">
                        <div class="col-2">
                            <label for="supplier" class="form-label">Supplier:</label>
                        </div>
                        <div class="col-10">
                            <select class="form-control" @bind="@order.SupplierId">
                                <option selected value="0">Select</option>
                                @foreach (var sup in suppliers!)
                                {
                                    <option value="@sup.Id">@sup.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="row mt-2">
                        <div class="col-2">
                            <label for="remarks" class="form-label">Remarks:</label>
                        </div>
                        <div class="col-10">
                            <textarea class="form-control remarks" rows="3" name="remarks" id="remarks" @bind="@order.Remarks"></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <div class="row">
                <div class="col-5">
                    <div class="row">
                        <div class="col-2">
                            <label for="item" class="form-label">Item:</label>
                        </div>
                        <div class="col-10">
                            @*<input type="text" class="form-control" @bind-value="@orderItem.ItemName">*@
                            <select class="form-control" @bind="@orderItem.ItemId">
                                <option selected value="0">Select</option>
                                    @foreach (var a in allItem!)
                                    {
                                        <option value="@a.Id">@a.Name</option>
                                    }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="col-3">
                    <div class="row">
                        <div class="col-2">
                            <label for="qty" class="form-label">Qty:</label>
                        </div>
                        <div class="col-10">
                            <input type="text" class="form-control" @bind="@orderItem.Quantity">
                        </div>
                    </div>
                </div>
                <div class="col-3">
                    <div class="row">
                        <div class="col-2">
                            <label for="rate" class="form-label">Rate:</label>
                        </div>
                        <div class="col-10">
                            <input type="text" class="form-control" @bind="@orderItem.Rate">
                        </div>
                    </div>
                </div>
                <div class="col-1">
                    <div class="row">
                        <button type="button" @onclick="@AddItem" class="btn btn-secondary" style="width:89%"><span class="oi oi-plus"></span></button>
                    </div>
                </div>
            </div>
            <table class="table table-hover table-striped table-bordered mt-1" style="background-color: ghostwhite;">
                <thead>
                    <tr class="text-center">
                        <th style="text-align:left;">Item Name</th>
                        <th>Qty.</th>
                        <th>Rate($)</th>
                        <th>Edit</th>
                        <th>Delete</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        <tr class="text-center">
                            <td style="text-align:left;">@item.ItemName</td>
                            <td>@item.Quantity</td>
                            <td>@item.Rate</td>
                                <td style="cursor:pointer;"><span class="oi oi-pencil" aria-hidden="true" @onclick="@(async () => await EditItem(item.ItemName))"></span></td>
                            <td style="cursor:pointer;"><span class="oi oi-trash" aria-hidden="true"></span></td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="row float-end" style="margin-top:1%; margin-bottom:1%;">
                <div class="col-6">
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
                <div class="col-6">
                    <button type="button" class="btn btn-danger">Close</button>
                </div>
            </div>
        </div>
        </EditForm>
    </div>
    <div class="card mt-3">
        <div class="card-header text-center">Order Details</div>
        <div class="card-body">
            <table class="table table-hover table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Ref.Id</th>
                        <th>PO No</th>
                        <th>PO Date</th>
                        <th>Supplier</th>
                        <th>Ex. Date</th>
                        <th class="text-center">Edit</th>
                        <th class="text-center">Delete</th>
                        <th class="text-center">Export</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in orders!)
                    {
                        <tr>
                            <td>@item.ReferenceId</td>
                            <td>@item.OrderNo</td>
                            <td>@item.OrderDate.ToShortDateString()</td>
                            <td>@item.SupplierName</td>
                            <td>@item.ExpectedDate.ToShortDateString()</td>
                            <td class="text-center" style="cursor:pointer;"><span class="oi oi-pencil" aria-hidden="true"></span></td>
                            <td class="text-center" style="cursor:pointer;"><span class="oi oi-trash" aria-hidden="true" @onclick="@(async () => await DeleteOrder(item.Id))"></span></td>
                            <td class="text-center" style="cursor:pointer;"><span class="oi oi-basket" aria-hidden="true"></span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="mt-3 text-center">
    <div class="alert alert-success">@showMessage</div>
</div>

@code {

    TableValuedParameter orderItem = new TableValuedParameter();
    List<TableValuedParameter> items = new List<TableValuedParameter>();
    List<Supplier>? suppliers = new();
    List<Item>? allItem = new();
    Order order = new();
    List<Order>? orders = new();

    protected void AddItem()
    {
        string itemName = allItem!.FirstOrDefault(x => x.Id == orderItem.ItemId)!.Name;
        items.Add(new TableValuedParameter()
        {
            ItemId = orderItem.ItemId,
            ItemName = itemName,
            Quantity = orderItem.Quantity,
            Rate = orderItem.Rate
        });

        StateHasChanged();
    }
    private string showMessage = string.Empty;
    protected async Task CreateOrder()
    {
        order.OrderItem = items;
        if(items.Count > 0)
        {
            var response = await Http.PostAsJsonAsync("https://localhost:44337/api/order/CreateOrder", order);
            if (response.IsSuccessStatusCode)
            {
                showMessage = "Order Created Successfully..!";
                orders = await Http.GetFromJsonAsync<List<Order>>("https://localhost:44337/api/order/getallorder");
            }
            else
            {
                showMessage = "Order Created Failed..!";
            }
        }
        else
        {
            showMessage = "Please add at least 1 item";
        }
    }

    private async Task FetchIntialData()
    {
        suppliers = await Http.GetFromJsonAsync<List<Supplier>>("https://localhost:44337/api/supplier/GetAllSupplier");
        allItem = await Http.GetFromJsonAsync<List<Item>>("https://localhost:44337/api/item/GetAllItem");
        orders = await Http.GetFromJsonAsync<List<Order>>("https://localhost:44337/api/order/getallorder");
    }

    protected override async Task OnInitializedAsync()
    {
        await FetchIntialData();
    }
    #region Search
    private Item? selectedItem;
    protected async Task<IEnumerable<Item>> SearchItem(string searchTxt)
    {
        return await Task.FromResult(allItem!.Where(x => x.Name.ToLower().Contains(searchTxt.ToLower())).ToList());
    }
    #endregion

    protected void Increment()
    {
        order.ReferenceId++;
    }
    protected void Decrement()
    {
        if(order.ReferenceId > 0)
        {
            order.ReferenceId--;
        }
    }
    protected async Task EditItem(string itemName)
    {
        items.Remove(items.FirstOrDefault(x => x.ItemName == itemName)!);
    }
    protected async Task DeleteOrder(int id)
    {
        var response = await Http.DeleteAsync("https://localhost:44337/api/order/RemoveOrder/" + id);
        if (response.IsSuccessStatusCode)
        {
            showMessage = "Order Deleted Successfully..!";
            orders = await Http.GetFromJsonAsync<List<Order>>("https://localhost:44337/api/order/getallorder");
        }
        else
        {
            showMessage = "Order Deleted Failed..!";
        }
    }
}
