@page "/fetchorderdata"
@using OrderManagement.UI.Models;
@inject HttpClient Http

<PageTitle>All Orders</PageTitle>

<h3>All Orders</h3>

@if (orders == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="container mt-3">
        <table class="table table-hover table-striped table-bordered">
            <thead>
                <tr>
                    <th>Ref.Id</th>
                    <th>PO No</th>
                    <th>PO Date</th>
                    <th>Supplier</th>
                    <th>Ex. Date</th>
                    <th class="text-center">Edit</th>
                    <th class="text-center">Delete</th>
                    <th class="text-center">Export</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in orders)
                {
                    <tr>
                        <td>@item.ReferenceId</td>
                        <td>@item.OrderNo</td>
                        <td>@item.OrderDate.ToShortDateString()</td>
                        <td>@item.SupplierName</td>
                        <td>@item.ExpectedDate.ToShortDateString()</td>
                        <td class="text-center" style="cursor:pointer;"><span class="oi oi-pencil" aria-hidden="true"></span></td>
                        <td class="text-center" style="cursor:pointer;"><span class="oi oi-trash" aria-hidden="true"></span></td>
                        <td class="text-center" style="cursor:pointer;"><span class="oi oi-basket" aria-hidden="true"></span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    List<Order>? orders;

    protected override async Task OnInitializedAsync()
    {
        orders = await Http.GetFromJsonAsync<List<Order>>("https://localhost:44337/api/order/getallorder");
        
    }
}
